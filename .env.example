# ===== Telegram =====
# Token von @BotFather
TELEGRAM_BOT_TOKEN=123456789:dein-bot-token
# Chats, die Alarme erhalten (kommagetrennt)
TELEGRAM_CHAT_IDS=111111111
# Nutzer, die den Bot bedienen dürfen (leer = Chat-IDs von oben)
ALLOWED_TELEGRAM_USER_IDS=111111111

# ===== Allgemein =====
HOST_LABEL=Mein Ubuntu-Server
CHECK_INTERVAL_SECONDS=240
SLOW_CHECK_INTERVAL_SECONDS=1800
TELEGRAM_POLL_INTERVAL_SECONDS=15
ALERT_REMINDER_SECONDS=21600

# ===== Schwellwerte in Prozent =====
CPU_WARN=75
CPU_CRIT=90
RAM_WARN=80
RAM_CRIT=90
DISK_WARN=80
DISK_CRIT=90

# ===== Überwachung =====
# Dienste, bei deren Ausfall alarmiert wird
WATCH_SERVICES=ssh.service,cron.service
# Zusätzliche eigene Dienste anhand von Namensbestandteilen anzeigen
SERVICE_KEYWORDS=bot,guardian
# TLS-Zertifikate prüfen (Ablaufdatum)
CERT_HOSTS=example.com
# Weitere TCP-Checks (host:port, kommagetrennt)
EXTRA_TCP_CHECKS=192.168.1.10:22,192.168.1.10:8006
# Router-IP, falls sie nicht automatisch erkannt wird
ROUTER_IP=192.168.1.1
ENABLE_DOCKER=false

# ===== Proxmox (optional) =====
PROXMOX_ENABLED=false
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
PROXMOX_NODE=proxmox
PROXMOX_TOKEN_NAME=guardian
PROXMOX_TOKEN_UUID=

# ===== Guardian API (api/main.py) =====
# Pflicht-Header X-API-Key für den Restart-Endpunkt
GUARDIAN_API_KEY=
# Dienste, die per API neu gestartet werden dürfen
GUARDIAN_API_RESTART_ALLOW=ubuntu-guardian.service
